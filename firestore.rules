rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // v148: connection-kind pair checks. The kind of the pair
    // between two uids rides their accepted request doc (either
    // direction — the accepted value is stamped on the doc and
    // re-stamped by a kind change from either side). A pre-v148
    // doc has no kind field: .get('kind', 'all') reads it as
    // 'all' (grandfathered — Full access), and a missing
    // endedAt reads as 0 (the one-time pair is still alive).
    function pairLimited(a, b) {
      return (exists(/databases/$(database)/documents/requests/$(a + '_' + b))
          && get(/databases/$(database)/documents/requests/$(a + '_' + b)).data.status == 'accepted'
          && get(/databases/$(database)/documents/requests/$(a + '_' + b)).data.get('kind', 'all') == 'limited')
        || (exists(/databases/$(database)/documents/requests/$(b + '_' + a))
          && get(/databases/$(database)/documents/requests/$(b + '_' + a)).data.status == 'accepted'
          && get(/databases/$(database)/documents/requests/$(b + '_' + a)).data.get('kind', 'all') == 'limited');
    }
    function pairEnded(a, b) {
      return (exists(/databases/$(database)/documents/requests/$(a + '_' + b))
          && get(/databases/$(database)/documents/requests/$(a + '_' + b)).data.status == 'accepted'
          && get(/databases/$(database)/documents/requests/$(a + '_' + b)).data.get('endedAt', 0) > 0)
        || (exists(/databases/$(database)/documents/requests/$(b + '_' + a))
          && get(/databases/$(database)/documents/requests/$(b + '_' + a)).data.status == 'accepted'
          && get(/databases/$(database)/documents/requests/$(b + '_' + a)).data.get('endedAt', 0) > 0);
    }

    // Meticulous stores ALL app data under the signed-in user's own tree:
    //   users/{uid}/kv/{key}          (cloud sync store)
    //   users/{uid}/meta, sessions, feedback, revenue, dispatches, fuel,
    //   damage, invoices, pnl, pnl_drivers, pnl_wage_entries, maintenance
    // Owner-only: a signed-in user may read/write only their own tree.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Connect directory (v131): a small PUBLIC record per account so
    // users can find each other by name. Identity ONLY — display
    // name, business name, role (+ lowercase/token search indexes
    // derived from those same strings). v155 adds the face (driver /
    // both / office — whether the person drives); v147 adds the
    // PERSON (the account holder's own first + last name, which IS
    // the display name when known; the business rides as its own
    // field, second). No email, no rates, no personal data.
    // Readable by any signed-in user (search needs it); writable
    // only by the account it describes.
    match /directory/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.data.name is string
        && request.resource.data.business is string
        && request.resource.data.role is string;
    }

    // Connect requests (v131): one doc per ordered pair,
    // id = "{fromUid}_{toUid}", fields {from, to, fromName,
    // fromBusiness, fromRole, toName, toBusiness, toRole, status,
    // createdAt, updatedAt} — the name/business/role fields are the
    // same identity-only values the directory publishes. v155 adds
    // fromFace/toFace; v147 adds fromPerson/toPerson — the same
    // ride-along snapshots, unchecked here like the face.
    // Readable by the two parties only. Created by the sender, and
    // only as 'pending'. The recipient answers (pending ->
    // accepted/declined); the sender may re-open a declined request
    // (-> pending). Neither side can rewrite the pair (from/to are
    // immutable after create). Nobody else can touch a request.
    // v144: the read also passes when the doc does NOT exist yet
    // (resource == null). sendRequest probes the pair doc before
    // creating it; without the guard, evaluating resource.data.*
    // on a missing doc errors, Firestore treats an errored rule
    // as DENY, and the probe rejects — no FIRST request between
    // two accounts could ever be created. The probe of a missing
    // doc reveals nothing but its own absence; an existing doc
    // still reads for its two parties only.
    match /requests/{requestId} {
      allow read: if request.auth != null
        && (resource == null
          || request.auth.uid == resource.data.from
          || request.auth.uid == resource.data.to);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.from
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null
        && request.resource.data.from == resource.data.from
        && request.resource.data.to == resource.data.to
        && (
          (request.auth.uid == resource.data.to
            && resource.data.status == 'pending'
            && request.resource.data.status in ['accepted', 'declined'])
          || (request.auth.uid == resource.data.from
            && resource.data.status == 'declined'
            && request.resource.data.status == 'pending')
          // v148: EITHER party re-stamps the KIND of an accepted
          // connection (a kind change from the connection's row,
          // or the one-time sweep stamping the end) — nothing but
          // the kind fields may move, and the pair stays accepted
          || ((request.auth.uid == resource.data.from
              || request.auth.uid == resource.data.to)
            && resource.data.status == 'accepted'
            && request.resource.data.status == 'accepted'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kind', 'onceDate', 'endedAt', 'updatedAt']))
          // v148: the sender re-opens an ENDED one-time pair with
          // a fresh request — the end clears as it re-opens
          || (request.auth.uid == resource.data.from
            && resource.data.status == 'accepted'
            && resource.data.get('endedAt', 0) > 0
            && request.resource.data.status == 'pending'
            && request.resource.data.get('endedAt', 0) == 0)
        );
      allow delete: if false;
    }

    // Connect shared days (v132): shareddays/{driverUid}_{date} —
    // ONE record per driver per day holding FACTS ONLY (dispatches
    // with their ticket close facts, session hours, loads). No
    // rates or money ever enter the record; each side prices it
    // with its own rates on its own side. Readable ONLY by the
    // driver and the peers named in the record's viewers list
    // (his accepted connections at publish time); writable ONLY
    // by the driver it describes — a peer can never write another
    // account's day. The driver field is immutable after create.
    match /shareddays/{dayId} {
      // v148: a LIMITED viewer (the dispatcher's kind) and a
      // viewer of an ENDED one-time pair are shut out even when
      // a stale record still names them — the pair's kind on
      // the request doc governs, not the viewers list alone.
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.driver
          || (request.auth.uid in resource.data.viewers
            && !pairLimited(resource.data.driver, request.auth.uid)
            && !pairEnded(resource.data.driver, request.auth.uid)));
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.driver
        && request.resource.data.viewers is list;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.driver
        && request.resource.data.driver == resource.data.driver
        && request.resource.data.viewers is list;
      allow delete: if false;
    }

    // Connect pipe dispatches (v132): pipedispatches/{id} — a
    // dispatch one account sends to a CONNECTED peer. Fields
    // {from, to, fromName, fromBusiness, jobSite, date,
    // scheduledAt, equipment, material, notes, status, sentAt,
    // deliveredAt, seenAt}. Readable by the two parties only.
    // Created by the sender, only as 'sent'. A sent dispatch is
    // SEALED: the sender can never edit it after sending; only
    // the RECIPIENT may advance the receipt marks (sent ->
    // delivered -> seen, timestamps included), and from/to are
    // immutable after create. Nobody else can touch one.
    match /pipedispatches/{pipeId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.from
        && request.resource.data.status == 'sent';
      allow update: if request.auth != null
        && request.auth.uid == resource.data.to
        && request.resource.data.from == resource.data.from
        && request.resource.data.to == resource.data.to
        && request.resource.data.jobSite == resource.data.jobSite
        && request.resource.data.date == resource.data.date
        && request.resource.data.scheduledAt == resource.data.scheduledAt
        && request.resource.data.equipment == resource.data.equipment
        && request.resource.data.material == resource.data.material
        && request.resource.data.notes == resource.data.notes
        && ((resource.data.status == 'sent' && request.resource.data.status in ['delivered', 'seen'])
          || (resource.data.status == 'delivered' && request.resource.data.status == 'seen'));
      allow delete: if false;
    }

    // Connect shared records (v146): sharedrecords/{driverUid} —
    // ONE record per driver holding his FUEL entries (date, time,
    // station, litres, amount, $/L, odometer — the full receipt
    // data; the photo itself rides sharedphotos), his other
    // Fuel & Expense entries, and his MAINTENANCE record
    // (odometer, next-service targets, due list, the annual
    // inspection expiry, recent services). Readable ONLY by the
    // driver and the peers named in the record's viewers list
    // (his accepted connections at publish time); writable ONLY
    // by the driver it describes. The driver field is immutable
    // after create, and the doc id IS the driver's uid.
    match /sharedrecords/{driverId} {
      // v148: same kind gates as the shared days — a limited
      // viewer / an ended one-time viewer reads nothing here.
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.driver
          || (request.auth.uid in resource.data.viewers
            && !pairLimited(resource.data.driver, request.auth.uid)
            && !pairEnded(resource.data.driver, request.auth.uid)));
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.driver
        && request.auth.uid == driverId
        && request.resource.data.viewers is list;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.driver
        && request.auth.uid == driverId
        && request.resource.data.driver == resource.data.driver
        && request.resource.data.viewers is list;
      allow delete: if false;
    }

    // Connect shared billing (v146): sharedbilling/{driverUid}_{viewerUid} —
    // the driver's ISSUED pay invoices for periods billed to ONE
    // payer (the bill-to is matched against that payer's names on
    // the DRIVER's side before anything is written — no other
    // customer's invoice is ever in this doc), with the full
    // document payload so the payer renders/prints the driver's
    // own document, plus the period manifests pairing with those
    // invoices (the manifest's printed lines per day). Readable
    // ONLY by the driver and the one viewer the doc names;
    // writable ONLY by the driver; driver and viewer are
    // immutable after create.
    match /sharedbilling/{billingId} {
      // v148: same kind gates — billing is exactly what a
      // limited connection withholds.
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.driver
          || (request.auth.uid == resource.data.viewer
            && !pairLimited(resource.data.driver, request.auth.uid)
            && !pairEnded(resource.data.driver, request.auth.uid)));
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.driver
        && request.resource.data.viewer is string;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.driver
        && request.resource.data.driver == resource.data.driver
        && request.resource.data.viewer == resource.data.viewer;
      allow delete: if false;
    }

    // Connect shared receipt photos (v146):
    // sharedphotos/{driverUid}_{fillKey} — a downscaled rendition
    // of ONE of the driver's fuel receipt photos, published for
    // the same viewers as his records doc (the facts stay in
    // sharedrecords; only the picture rides here). Readable ONLY
    // by the driver and the named viewers; writable ONLY by the
    // driver — who may also delete, so a superseded rendition
    // (an edited or deleted fill) is pruned by its owner.
    match /sharedphotos/{photoId} {
      // v148: same kind gates as the records they belong to.
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.driver
          || (request.auth.uid in resource.data.viewers
            && !pairLimited(resource.data.driver, request.auth.uid)
            && !pairEnded(resource.data.driver, request.auth.uid)));
      allow create, update: if request.auth != null
        && request.auth.uid == request.resource.data.driver
        && request.resource.data.viewers is list;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.driver;
    }

    // Connect shared manifests (v148):
    // sharedmanifests/{driverUid}_{viewerUid} — the ONE share a
    // LIMITED connection carries besides the dispatch pipe: the
    // manifest lines for exactly the days that viewer dispatched
    // to the driver. Readable ONLY by the driver and the one
    // viewer the doc names, and only while their pair has not
    // ENDED (a one-time pair that ended itself shuts here too);
    // writable ONLY by the driver; driver and viewer are
    // immutable after create.
    match /sharedmanifests/{mfId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.driver
          || (request.auth.uid == resource.data.viewer
            && !pairEnded(resource.data.driver, request.auth.uid)));
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.driver
        && request.resource.data.viewer is string;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.driver
        && request.resource.data.driver == resource.data.driver
        && request.resource.data.viewer == resource.data.viewer;
      allow delete: if false;
    }

    // No other paths are used by the app; everything else stays denied.
  }
}
